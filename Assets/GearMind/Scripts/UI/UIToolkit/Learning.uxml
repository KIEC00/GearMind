    <Style src="project://database/Assets/GearMind/Scripts/UI/UIToolkit/Learning.uss?fileID=7433441132597879392&amp;guid=44091d07199a12741975a81640098a6f&amp;type=3#Learning" />
    <ui:VisualElement name="RootContainer" enabled="true" style="flex-grow: 1; justify-content: center; align-items: center; background-color: rgba(0, 0, 0, 0.46); display: flex;">
        <ui:VisualElement name="CenteredRect" style="width: 1004px; height: 622px; background-color: rgb(255, 255, 255); border-radius: 20px; flex-direction: column; justify-content: center; align-items: center; padding: 40px; padding-bottom: 20px; padding-right: 121px; padding-left: 121px;">
            <ui:Image name="TrainingImage" style="width: 760px; height: 426px; margin-bottom: 0; background-color: rgb(255, 255, 255); border-radius: 15px; background-image: none; margin-top: 0; margin-right: 0; margin-left: 0;" />
            <ui:Label name="TrainingText" text="Текст обучения" style="font-size: 28px; color: black; text-align: center; margin-bottom: 8px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/BoldPixels.ttf?fileID=12800000&amp;guid=0da78171e9a8d374b8549aba0c2dd785&amp;type=3#BoldPixels&quot;); -unity-text-align: middle-center; white-space: normal;" />
            <ui:VisualElement name="Buttons" style="flex-direction: column; justify-content: center; align-items: center;">
                <ui:Button name="StartButton" text="Ок" class="green-button" style="width: 77px; height: 70px; font-size: 30px; border-color: rgba(255, 255, 255, 0); border-width: 0; background-color: rgb(255, 255, 255); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;" />
                <ui:Button name="NextButton" text="&#10;" class="button-mask" style="width: 70px; height: 70px; font-size: 30px; border-color: rgba(255, 255, 255, 0); border-width: 0; background-color: rgb(255, 255, 255); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; background-image: url(&quot;project://database/Assets/GearMind/Textures/UI/ToolbarBtn.png?fileID=2800000&amp;guid=74d10c85a8b0bdd46bdaafd323d70ad8&amp;type=3#ToolbarBtn&quot;); padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
